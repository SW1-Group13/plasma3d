# ==========================================================
# plasma3d - Plantilla de variables de entorno (raiz del proyecto)
# Copia este archivo a .env y completa los valores.
# Backend: Django (plasma3d_api)  |  Frontend: Angular SSR (plasma3d_web)
# ==========================================================

# ---------------------- BACKEND ---------------------------
# --- Base de datos PostgreSQL ---
POSTGRES_DB=plasma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://angular-app:4000
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4000
CSRF_COOKIE_SECURE=False

# --- IA (Google Gemini) ---
GEMINI_API_KEY=tu_gemini_api_key

# --- Blockchain (Polygon Amoy) ---
CONTRACT_ADDR=0x0000000000000000000000000000000000000000
PRIVATE_KEY=tu_private_key_de_wallet

# --- Pagos (Stripe) ---
STRIPE_API_KEY=sk_test_tu_clave_de_stripe

# --- Django ---
SECRET_KEY=cambia_esta_clave_secreta
DEBUG=True
ALLOWED_HOSTS=*

# ---------------------- FRONTEND --------------------------
# --- Servidor SSR (Express) ---
PORT=4000

# --- API / Servicios (Angular se compila desde .env.ts) ---
ENDPOINT=http://localhost:8000/
CLOUDINARY=https://api.cloudinary.com/v1_1
# Endpoint compilado en la imagen de produccion (docker-compose.prod.yml)
PROD_ENDPOINT=https://app.bratox.me/

# --- Docker Compose ---
API_URL=http://web:8000
