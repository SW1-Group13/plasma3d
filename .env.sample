# ============================================
# PLASMA3D - Plantilla de variables de entorno
# Copia este archivo a .env y completa los valores.
# Backend: Django (plasma3d_api) | Frontend: React + Vite (plasma3d_web)
# ============================================

# ============================================
# DATABASE - PostgreSQL
# ============================================
# PostgreSQL (fuente de verdad)
# Fuera de Docker usa POSTGRES_HOST=localhost
POSTGRES_DB=plasma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=071104
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# DJANGO
# ============================================
# Configuracion de Django
SECRET_KEY=
DEBUG=True

# ============================================
# CORS / CSRF
# ============================================
# Origenes permitidos y proteccion CSRF
# ALLOWED_HOSTS=["*"] en settings.py
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://plasma3d.sebaces.fyi,http://plasma3d.sebaces.fyi
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://plasma3d.sebaces.fyi,http://plasma3d.sebaces.fyi
CSRF_COOKIE_SECURE=False

# ============================================
# ADMINISTRADOR POR DEFECTO
# ============================================
# Se crea/asegura automaticamente tras "migrate" (no se duplica).
# Cambia la clave antes de desplegar en produccion.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@plasma3d.local
ADMIN_PASSWORD=Admin12345!

# ============================================
# PAGOS - STRIPE
# ============================================
# Secret key y publishable key deben ser de la MISMA cuenta de Stripe.
# En desarrollo usa claves de MODO TEST (sk_test_... / pk_test_...).
# Webhook opcional: stripe listen --forward-to localhost:8000/api/users/payment/webhook/
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# IA - GEMINI
# ============================================
# Analisis de riesgo con IA (sin clave usa el motor de reglas).
GEMINI_API_KEY=

# ============================================
# ALMACENAMIENTO DE MEDIA
# ============================================
# local | cloudinary
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=plasma3d

# ============================================
# FRONTEND - VITE
# ============================================
# Vite en desarrollo; Nginx en produccion.
# En Docker: http://plasma3d-api:8000; en host: http://localhost:8000.
FRONTEND_PORT=5173
VITE_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

