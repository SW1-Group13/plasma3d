# ==========================================================
# plasma3d - Plantilla de variables de entorno (raiz del proyecto)
# Copia este archivo a .env y completa los valores.
# Backend: Django (plasma3d_api)  |  Frontend: React + Vite (plasma3d_web)
# ==========================================================

# ---------------------- BACKEND ---------------------------
# --- Base de datos PostgreSQL ---
POSTGRES_DB=plasma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- CORS / CSRF ---
# El backend permite todos los hosts (ALLOWED_HOSTS=['*'] en settings.py)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SECURE=False

# --- IA (Google Gemini) ---
GEMINI_API_KEY=

# --- Pagos (Stripe) ---
# Secret key: SOLO backend (nunca al frontend)
STRIPE_API_KEY=
# Publishable key: se entrega al frontend via GET /api/users/payment/config/
STRIPE_PUBLISHABLE_KEY=
# Usa claves de MODO TEST (sk_test_... / pk_test_...) en desarrollo y para la demo.
# Opcional: firma del webhook POST /api/users/payment/webhook/
#   stripe listen --forward-to localhost:8000/api/users/payment/webhook/
STRIPE_WEBHOOK_SECRET=

# --- Django ---
SECRET_KEY=
DEBUG=True

# --- Almacenamiento de media (local | cloudinary) ---
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=plasma3d


# ---------------------- FRONTEND (React + Vite) --------------------------
# Puerto del dev server / preview
FRONTEND_PORT=5173
# Target del proxy de Vite y base de la API.
# En Docker (dev) suele ser http://plasma3d-api:8000; en host http://localhost:8000.
VITE_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
