# ==========================================================
# plasma3d - Plantilla de variables de entorno (raiz del proyecto)
# Copia este archivo a .env y completa los valores.
# Backend: Django (plasma3d_api)  |  Frontend: React + Vite (plasma3d_web)
# ==========================================================

# ---------------------- BACKEND ---------------------------
# --- Base de datos PostgreSQL ---
POSTGRES_DB=plasma_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- CORS / CSRF ---
# El backend permite todos los hosts (ALLOWED_HOSTS=['*'] en settings.py)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_COOKIE_SECURE=False

# --- IA (Google Gemini) ---
GEMINI_API_KEY=tu_gemini_api_key

# --- Blockchain (Polygon Amoy) ---
CONTRACT_ADDR=0x0000000000000000000000000000000000000000
PRIVATE_KEY=tu_private_key_de_wallet

# --- Pagos (Stripe) ---
STRIPE_API_KEY=sk_test_tu_clave_de_stripe

# --- Django ---
SECRET_KEY=cambia_esta_clave_secreta
DEBUG=True

# ---------------------- FRONTEND (React + Vite) --------------------------
# Puerto del dev server / preview
FRONTEND_PORT=5173
# Target del proxy de Vite hacia el backend Django
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
# Base relativa usada por la app (proxy en dev, nginx en prod)
VITE_API_BASE=/
# Cloudinary
VITE_CLOUDINARY=https://api.cloudinary.com/v1_1
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset
# Stripe (clave publica)
VITE_STRIPE_PK=pk_test_tu_clave_publica
