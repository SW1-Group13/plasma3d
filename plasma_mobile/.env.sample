# ============================================
# PLASMA3D MOBILE - Variables de compilacion
# ============================================
# Flutter NO lee este archivo automaticamente. Estas variables se pasan con
# --dart-define al compilar o ejecutar.
#
# Produccion sin HTTPS (IP publica de AWS):
#   flutter build apk --release --dart-define=API_BASE_URL=http://54.89.10.236/ --dart-define=API_MEDIA_URL=http://54.89.10.236 --dart-define=WEB_URL=http://54.89.10.236
#
# Desarrollo local (IP de tu PC):
#   flutter run --dart-define=API_BASE_URL=http://192.168.0.14:8000/ --dart-define=API_MEDIA_URL=http://192.168.0.14:8000 --dart-define=WEB_URL=http://192.168.0.14:5173

# Base del backend. Debe terminar en /.
API_BASE_URL=http://54.89.10.236/

# Base para archivos media. No debe terminar en /.
API_MEDIA_URL=http://54.89.10.236

# Web para planes y pagos. No debe terminar en /.
WEB_URL=http://54.89.10.236
